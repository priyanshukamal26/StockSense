# StockSense Backend — Environment Variables
# Copy this to .env and fill in real values. Never commit .env.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://stocksense:stocksense_dev@localhost:5432/stocksense"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a random 64-character string in production
JWT_SECRET="replace_with_a_long_random_secret_at_least_64_chars_long"
JWT_REFRESH_SECRET="replace_with_a_different_long_random_secret_for_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ─── Email / OTP ─────────────────────────────────────────────────────────────
# Set SMTP credentials to send real emails, OR leave blank to use dev-mode
# (OTP is logged to console and returned in the API response in development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="StockSense <noreply@stocksense.dev>"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Auth routes: max attempts per window
RATE_LIMIT_AUTH_MAX="5"
RATE_LIMIT_AUTH_WINDOW_MS="900000"
# OTP specific: 1 per 60s per account
RATE_LIMIT_OTP_WINDOW_MS="60000"
